{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "tests", "types"],
  "glint": {
    "additionalSpecialForms": {
      "globals": {
        "eq": "===",
        "notEq": "!==",
        "and": "&&",
        "or": "||"
      }
    }
  },
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "charlesfries/tests/*": ["./tests/*"],
      "charlesfries/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types",
      "@ember-intl/vite/virtual"
    ]
  }
}
